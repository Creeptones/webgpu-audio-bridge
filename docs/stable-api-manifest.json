  "policy": {
    "root": "1.0 candidate surface. Additions require README/changelog mention and should not depend on experimental JIT/DAG/WebNN modules.",
    "rootBuckets": "Every root export (values AND types) is listed in exactly one bucket; `npm run check:api-boundary` fails on any unlisted or stale name. primary = app surface; gpuWorklet = GPU readback + WGSL/WASM/worklet codegen; advanced = composable stable building blocks; frontierOnRoot = frontier-grade APIs currently on the root that must be promoted deliberately or moved behind /experimental before 1.0; deprecatedShims = @deprecated re-exports scheduled for removal at 0.10.0.",
    "experimental": "Lab surface outside the 1.0 stability contract. Shapes may change before promotion.",
    "packageExports": "Only '.', './worklet', './worklet/decoder.wasm', './experimental', and './experimental/core' are published subpaths.",
    "dependencies": "The stable core has no direct runtime dependencies. The experimental JIT parser uses acorn as an optional peer dependency and repo devDependency.",
    "snapshots": "docs/api-snapshots/*.api.txt are MEMBER-LEVEL snapshots generated from the sources by scripts/_apiSurface.mjs (TypeScript compiler API): every export plus every public member signature, and the internal declarations the public surface reaches. Any added/removed/renamed/retyped public member changes them.",
    "frontierMembers": "Members of otherwise-stable root declarations that are frontier-grade: the predicted/Kalman pulls + readback median on Bridge (BridgeImpl), the f32x4 kalmanWasm option, SpscRingOptions.notify ('waiter-flag' is experimental), and BridgeGPUSourceOptions.writeTarget ('shared' is reserved and always throws). They are outside the 1.0 stability contract until deliberately promoted. check:api-boundary verifies each still exists in the member-level root snapshot."
  }
